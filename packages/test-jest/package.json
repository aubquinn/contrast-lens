    },
    "dependencies": {
        "@contrast-lens/jest": "workspace:*"
    },
    "devDependencies": {
        "@swc/core": "^1.15.7",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "cross-env": "^10.1.0",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1"
    }
}
