{
    "name": "@contrast-lens/browser-extension",
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm run build:lib && pnpm run build:extension",
        "build:lib": "tsc -b tsconfig.build.json",
        "build:extension": "shx cp manifest.json dist/ && shx cp popup.html dist/ && shx cp popup.js dist/ && shx cp background.js dist/ && shx cp content.js dist/",
        "typecheck": "tsc -p . --noEmit",
        "dev": "pnpm run build:lib -- --watch",
        "test": "pnpm run test:run",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@contrast-lens/engine": "workspace:*"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "vitest": "catalog:"
    },
    "private": true
}
