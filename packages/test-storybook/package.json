{
    "name": "test-storybook",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc -p . --noEmit",
        "test": "pnpm run test:run",
        "test:run": "pnpm --workspace-root exec vitest run --project storybook",
        "test:watch": "pnpm --workspace-root exec vitest --project storybook",
        "storybook": "node ../../scripts/dev-storybook.mjs",
        "build-storybook": "storybook build --config-dir ../../.storybook",
        "storybook:doctor": "storybook doctor --config-dir ../../.storybook"
    },
    "dependencies": {
        "@contrast-lens/storybook-addon": "workspace:*",
        "@contrast-lens/test-components": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@storybook/addon-vitest": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "playwright": "catalog:",
        "storybook": "catalog:",
        "vitest": "catalog:"
    }
}
