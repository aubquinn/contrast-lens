{
    "name": "@contrast-lens/jest",
    "version": "0.0.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./extend-expect": {
            "types": "./dist/extend-expect.d.ts",
            "import": "./dist/extend-expect.js"
        },
        "./matchers": {
            "types": "./dist/matcher.d.ts",
            "import": "./dist/matcher.js"
        }
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "typecheck": "tsc -p . --noEmit",
        "test": "pnpm run test:run",
        "test:run": "vitest run",
        "prepack": "node ../../scripts/prepack.mjs"
    },
    "dependencies": {
        "@contrast-lens/engine": "workspace:*"
    },
    "peerDependencies": {
        "expect": ">=29",
        "jest": ">=29"
    },
    "devDependencies": {
        "@types/jest": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "vitest": "catalog:"
    },
    "description": "Jest matchers for Contrast Lens high-contrast accessibility rules.",
    "keywords": [
        "jest",
        "accessibility",
        "high-contrast",
        "forced-colors",
        "a11y"
    ],
    "license": "MIT",
    "author": "Aubrey Quinn",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aubquinn/contrast-lens.git",
        "directory": "packages/jest"
    },
    "homepage": "https://github.com/aubquinn/contrast-lens/tree/main/packages/jest#readme",
    "bugs": {
        "url": "https://github.com/aubquinn/contrast-lens/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
