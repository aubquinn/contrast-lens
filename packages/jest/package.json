{
    "name": "@contrast-lens/jest",
    "version": "0.0.0",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./extend-expect": {
            "types": "./dist/extend-expect.d.ts",
            "import": "./dist/extend-expect.js"
        },
        "./matchers": {
            "types": "./dist/matcher.d.ts",
            "import": "./dist/matcher.js"
        }
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "typecheck": "tsc -p . --noEmit",
        "test": "pnpm run test:run",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@contrast-lens/engine": "workspace:*"
    },
    "peerDependencies": {
        "expect": ">=29",
        "jest": ">=29"
    },
    "devDependencies": {
        "@types/jest": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "vitest": "catalog:"
    }
}
