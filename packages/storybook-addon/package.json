{
    "name": "@contrast-lens/storybook-addon",
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./preset": "./preset.js",
        "./preset.js": "./preset.js"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "preset.js"
    ],
    "scripts": {
        "build": "tsc -b && vite build --config vite.config.ts",
        "dev": "vite build --config vite.config.ts --watch",
        "typecheck": "tsc -p . --noEmit"
    },
    "dependencies": {
        "@chakra-ui/react": "catalog:",
        "@contrast-lens/engine": "workspace:*",
        "@heroicons/react": "^2.2.0",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "vite": "catalog:"
    }
}
