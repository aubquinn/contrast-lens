{
    "name": "@contrast-lens/storybook-addon",
    "version": "0.0.0",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.js",
    "type": "module",
    "exports": {
        ".": {
            "import": "./src/index.tsx",
            "require": "./dist/index.js"
        },
        "./*": "./src/*"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "preset.js"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p . --noEmit"
    },
    "dependencies": {
        "@contrast-lens/engine": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:"
    }
}
