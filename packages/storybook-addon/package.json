{
    "name": "@contrast-lens/storybook-addon",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./preset": "./preset.js",
        "./preset.js": "./preset.js"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "preset.js"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && vite build --config vite.config.ts",
        "dev": "vite build --config vite.config.ts --watch",
        "typecheck": "tsc -p . --noEmit",
        "test": "pnpm run test:run",
        "test:run": "vitest run",
        "prepack": "node ../../scripts/prepack.mjs"
    },
    "dependencies": {
        "@chakra-ui/react": "catalog:",
        "@contrast-lens/engine": "workspace:*",
        "@heroicons/react": "^2.2.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "storybook": "catalog:"
    },
    "peerDependencies": {
        "storybook": "^10.5.8"
    },
    "description": "Storybook addon for inspecting high-contrast accessibility findings.",
    "keywords": [
        "storybook-addon",
        "storybook",
        "accessibility",
        "high-contrast",
        "forced-colors"
    ],
    "license": "MIT",
    "author": "Aubrey Quinn",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aubquinn/contrast-lens.git",
        "directory": "packages/storybook-addon"
    },
    "homepage": "https://github.com/aubquinn/contrast-lens/tree/main/packages/storybook-addon#readme",
    "bugs": {
        "url": "https://github.com/aubquinn/contrast-lens/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
