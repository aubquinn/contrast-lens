{
    "name": "@contrast-lens/storybook-addon",
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./preset": "./preset.js",
        "./preset.js": "./preset.js"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "preset.js"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && vite build --config vite.config.ts",
        "dev": "vite build --config vite.config.ts --watch",
        "typecheck": "tsc -p . --noEmit",
        "test": "pnpm run test:run",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@chakra-ui/react": "catalog:",
        "@contrast-lens/engine": "workspace:*",
        "@heroicons/react": "^2.2.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "storybook": "catalog:"
    },
    "peerDependencies": {
        "storybook": "^10.5.8"
    }
}
