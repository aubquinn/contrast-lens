{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "declarationMap": false,
        "inlineSources": true
    },
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*.fixture.ts",
        "**/vitest.setup.ts",
        "**/vitest.setup.tsx",
        "src/test-utils.tsx",
        "**/*.test-d.ts"
    ],
    "references": [
        {
            "path": "../engine/tsconfig.build.json"
        }
    ]
}
