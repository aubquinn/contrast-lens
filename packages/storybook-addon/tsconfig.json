{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        // @chakra-ui/react's export barrels don't resolve under NodeNext; this package needs Bundler resolution.
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": ["src"],
    "references": [{ "path": "../engine" }]
}
