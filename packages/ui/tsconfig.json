{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "noEmit": true,
        // @chakra-ui/react's export barrels don't resolve under NodeNext; this package needs Bundler resolution.
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": ["src"],
    "references": [{ "path": "../engine/tsconfig.build.json" }]
}
