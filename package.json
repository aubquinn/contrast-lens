{
    "name": "contrast-lens",
    "private": true,
    "version": "0.0.0",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": "11.20.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm --recursive --if-present run build",
        "test": "pnpm --recursive --if-present run test",
        "typecheck": "pnpm --recursive --if-present run typecheck",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "clean": "shx rm -rf dist node_modules packages/*/dist",
        "storybook": "node scripts/dev-storybook.mjs",
        "storybook:serve": "storybook dev --port 6006",
        "build-storybook": "storybook build",
        "storybook:doctor": "storybook doctor"
    },
    "devDependencies": {
        "@contrast-lens/storybook-addon": "workspace:*",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-vitest": "^10.5.8",
        "@storybook/builder-vite": "^10.5.8",
        "@storybook/react-vite": "^10.5.8",
        "@types/node": "^20.14.0",
        "@typescript-eslint/eslint-plugin": "^5.60.1",
        "@typescript-eslint/parser": "^5.60.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^9.0.0",
        "eslint-config-standard-with-typescript": "^34.0.1",
        "eslint-plugin-import": "^2.30.0",
        "eslint-plugin-n": "^15.7.0",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^6.6.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "jsdom": "^22.1.0",
        "prettier": "^3.0.0",
        "sass": "^1.102.0",
        "shx": "^0.4.0",
        "storybook": "^10.5.8",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.0.7",
        "vitest": "^4.1.3"
    }
}
