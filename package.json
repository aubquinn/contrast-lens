{
    "name": "contrast-lens",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": "11.20.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm --recursive --if-present run build",
        "test": "pnpm run build && pnpm --recursive --if-present run test",
        "typecheck": "pnpm --filter @contrast-lens/engine run build && pnpm --recursive --if-present run typecheck",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "lint:oxlint": "oxlint .",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "clean": "shx rm -rf dist node_modules packages/*/dist",
        "storybook": "node scripts/dev-storybook.mjs",
        "storybook:serve": "storybook dev --port 6006",
        "build-storybook": "storybook build",
        "storybook:doctor": "storybook doctor"
    },
    "devDependencies": {
        "@contrast-lens/storybook-addon": "workspace:*",
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/builder-vite": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@types/node": "catalog:",
        "eslint": "^10.8.1",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "jsdom": "catalog:",
        "oxlint": "catalog:",
        "prettier": "^3.0.0",
        "sass": "^1.102.0",
        "shx": "^0.4.0",
        "storybook": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "^8.67.0",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
